# ─── Kirana Shop Portal ────────────────────────────────────────────────────────
# Copy to .env and fill in real values. Never commit .env to git.

# ── Branding (change these to white-label for a different brand) ────────────
BRAND_NAME="Kirana"
BASE_DOMAIN="kirana.dev"

# ── Session security ────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-32-char-random-secret"

# ── Supabase (same project as platform-command) ─────────────────────────────
SUPABASE_URL="https://arnnnanfigwevyuevasf.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<your-supabase-service-role-key>"

# ── Odoo (local Docker in dev, real instance in prod) ───────────────────────
ODOO_URL="http://localhost:8069"
ODOO_ADMIN_LOGIN="admin"
ODOO_ADMIN_PASSWORD="admin"

<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Override the OdooLogo OWL component used in customer display and POS -->
    <t t-name="kirana_rebrand.OdooLogo" t-inherit="point_of_sale.OdooLogo" t-inherit-mode="extension">
        <xpath expr="//div" position="replace">
            <!-- Replace the inline SVG with an empty div preserving original classes and styles to maintain layout -->
            <div t-attf-class="{{ props.class }}" t-attf-style="{{ props.style }}">
                <!-- Logo removed for white-labeling -->
            </div>
        </xpath>
    </t>
</templates>

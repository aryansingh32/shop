# ─── Stage 1: Build ──────────────────────────────────────────────────────────
FROM oven/bun:1.2-alpine AS builder

WORKDIR /app
COPY platform-command/package.json platform-command/bun.lock platform-command/bunfig.toml ./
ENV BUN_INSTALL_SKIP_MINIMUM_RELEASE_AGE=1
RUN bun install --frozen-lockfile --ignore-scripts 2>/dev/null || bun install --ignore-scripts

COPY platform-command/ .

# Force Nitro to build a standalone Node.js server
ENV NODE_ENV=production
ENV NITRO_PRESET=node-server

# Vite inlines VITE_* vars into the browser bundle at build time, so they must
# be passed in as build args here — setting them at container runtime (below)
# has no effect on code already compiled into the client-side JS.
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ARG VITE_SUPABASE_PROJECT_ID
ENV VITE_SUPABASE_URL=${VITE_SUPABASE_URL}
ENV VITE_SUPABASE_PUBLISHABLE_KEY=${VITE_SUPABASE_PUBLISHABLE_KEY}
ENV VITE_SUPABASE_PROJECT_ID=${VITE_SUPABASE_PROJECT_ID}

RUN bun run build

# ─── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM oven/bun:1.2-alpine AS runtime
WORKDIR /app

COPY platform-command/package.json platform-command/bun.lock platform-command/bunfig.toml ./
ENV BUN_INSTALL_SKIP_MINIMUM_RELEASE_AGE=1
RUN bun install --production --frozen-lockfile --ignore-scripts 2>/dev/null || bun install --production --ignore-scripts

# Nitro's node-server preset outputs a fully bundled standalone server in .output/server/index.mjs
COPY --from=builder /app/.output /app/.output

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

# Start the standalone HTTP server
CMD ["bun", ".output/server/index.mjs"]

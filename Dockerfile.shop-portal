# ─── Stage 1: Build ──────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app
COPY shop-portal/package.json shop-portal/package-lock.json* ./
RUN npm install --legacy-peer-deps --ignore-scripts
COPY shop-portal/ .
ENV NODE_ENV=production
ENV NITRO_PRESET=node-server
RUN npm run build

# ─── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM node:22-alpine AS runtime
WORKDIR /app

# Copy package files and install production dependencies to keep image small
COPY shop-portal/package.json shop-portal/package-lock.json* ./
RUN npm install --legacy-peer-deps --omit=dev --ignore-scripts

# Copy the built app and the HTTP server wrapper.
COPY --from=builder /app/dist /app/dist
COPY --from=builder /app/server.mjs /app/server.mjs

ENV NODE_ENV=production
ENV PORT=3001
EXPOSE 3001

CMD ["node", "server.mjs"]
